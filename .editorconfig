root = true

[*] # 表示所有文件适用
chartset = utf-8 # 编码格式
indent_style = space # 缩进风格(tab/space)
indent_size = 2 # 缩进大小
end_of_line = lf # 换行符(lf/crlf/cr)
trim_trailing_whitespace = true # 去除行尾空格
insert_final_newline = true # 插入新行


[*.md] # 表示所有md文件适用
max_line_length = off # 关闭最大行长度限制
trim_trailing_whitespace = false # 关闭行尾空格检查
